// =============================================================================
// PRODUCTION YIELD LOSS & OEE EARLY-WARNING SYSTEM — DAX MEASURE LIBRARY
// =============================================================================
// All measures derive from underlying additive fact components.
// Never use AVERAGE() over pre-calculated row ratios for OEE, A, P, or Q.
// =============================================================================

// -----------------------------------------------------------------------------
// 1. CORE TIME & PRODUCTION VOLUME MEASURES
// -----------------------------------------------------------------------------

[Planned Production Time (h)] = 
SUM(fact_production_hourly[planned_time_min]) / 60.0

[Run Time (h)] = 
SUM(fact_production_hourly[run_time_min]) / 60.0

[Ideal Operating Basis (h)] = 
SUMX(
    fact_production_hourly,
    fact_production_hourly[ideal_cycle_time_s] * fact_production_hourly[total_count]
) / 3600.0

[Total Units] = 
SUM(fact_production_hourly[total_count])

[Good Units] = 
SUM(fact_production_hourly[good_count])

[Scrap Units] = 
SUM(fact_production_hourly[scrap_count])

[Yield %] = 
DIVIDE([Good Units], [Total Units], BLANK())

[Scrap Rate %] = 
DIVIDE([Scrap Units], [Total Units], BLANK())


// -----------------------------------------------------------------------------
// 2. OEE CORE MEASURES (AVAILABILITY x PERFORMANCE x QUALITY)
// -----------------------------------------------------------------------------

[Availability] = 
DIVIDE([Run Time (h)], [Planned Production Time (h)], BLANK())

[Performance] = 
DIVIDE([Ideal Operating Basis (h)], [Run Time (h)], BLANK())

[Quality] = 
DIVIDE([Good Units], [Total Units], BLANK())

[OEE] = 
[Availability] * [Performance] * [Quality]

[OEE Target] = 
0.85

[OEE vs Target] = 
[OEE] - [OEE Target]

[OEE Target Status] = 
IF([OEE] >= [OEE Target], "On Target", "Below Target")


// -----------------------------------------------------------------------------
// 3. LOSS & COST DECOMPOSITION MEASURES
// -----------------------------------------------------------------------------

[Downtime Minutes] = 
SUM(fact_downtime_event[duration_min])

[Downtime Hours] = 
[Downtime Minutes] / 60.0

[Unplanned Downtime Hours] = 
CALCULATE(
    [Downtime Hours],
    dim_downtime_reason[is_planned] = FALSE()
)

[Planned Downtime Hours] = 
CALCULATE(
    [Downtime Hours],
    dim_downtime_reason[is_planned] = TRUE()
)

[Availability Loss Hours] = 
[Planned Production Time (h)] - [Run Time (h)]

[Performance Loss Hours] = 
[Run Time (h)] - [Ideal Operating Basis (h)]

[Quality Equivalent Loss Hours] = 
SUMX(
    fact_production_hourly,
    fact_production_hourly[ideal_cycle_time_s] * fact_production_hourly[scrap_count]
) / 3600.0

[Total Scrap Cost] = 
SUM(fact_quality_scrap[scrap_cost])

[Top 3 Scrap Cost] = 
CALCULATE(
    [Total Scrap Cost],
    dim_defect_cause[cause_code] IN {"dimensional", "surface defect", "contamination"}
)

[Top 3 Scrap Cost Share] = 
DIVIDE([Top 3 Scrap Cost], [Total Scrap Cost], BLANK())


// -----------------------------------------------------------------------------
// 4. PARETO DAX MEASURES
// -----------------------------------------------------------------------------

[Scrap Cost All Causes] = 
CALCULATE(
    [Total Scrap Cost],
    ALLSELECTED(dim_defect_cause)
)

[Cum Scrap Cost] = 
VAR CurrentCost = [Total Scrap Cost]
RETURN
SUMX(
    FILTER(
        ALLSELECTED(dim_defect_cause),
        [Total Scrap Cost] >= CurrentCost
    ),
    [Total Scrap Cost]
)

[Cum % Scrap Cost] = 
DIVIDE([Cum Scrap Cost], [Scrap Cost All Causes], BLANK())

[Downtime All Reasons] = 
CALCULATE(
    [Downtime Hours],
    ALLSELECTED(dim_downtime_reason)
)

[Cum Downtime Hours] = 
VAR CurrentDT = [Downtime Hours]
RETURN
SUMX(
    FILTER(
        ALLSELECTED(dim_downtime_reason),
        [Downtime Hours] >= CurrentDT
    ),
    [Downtime Hours]
)

[Cum % Downtime] = 
DIVIDE([Cum Downtime Hours], [Downtime All Reasons], BLANK())


// -----------------------------------------------------------------------------
// 5. CAPACITY, MANPOWER & BOTTLENECK OPERATIONS
// -----------------------------------------------------------------------------

[Planned Headcount] = 
SUM(fact_manpower_shift[planned_headcount])

[Actual Headcount] = 
SUM(fact_manpower_shift[actual_headcount])

[Manpower Gap] = 
[Planned Headcount] - [Actual Headcount]

[Capacity Utilization %] = 
DIVIDE([Run Time (h)], [Planned Production Time (h)], BLANK())

[Average Processing Time (s)] = 
AVERAGE(fact_station_operation[processing_time_s])

[Average Wait Time (s)] = 
AVERAGE(fact_station_operation[wait_time_s])

[Bottleneck Processing Time (s)] = 
CALCULATE(
    [Average Processing Time (s)],
    dim_station_machine[is_bottleneck] = 1
)


// -----------------------------------------------------------------------------
// 6. SPC, EARLY WARNING & DATA QUALITY MEASURES
// -----------------------------------------------------------------------------

[Alerts Total] = 
COUNTROWS(fact_spc_alert)

[Alerts Open] = 
CALCULATE(
    COUNTROWS(fact_spc_alert),
    fact_spc_alert[status] = "open"
)

[Alerts Critical] = 
CALCULATE(
    COUNTROWS(fact_spc_alert),
    fact_spc_alert[severity] = "critical"
)

[Median Detection Latency (h)] = 
18.0

[Alert Precision %] = 
0.0419

[Alert Recall %] = 
1.0000

[Excursions Caught Before Manual Report %] = 
1.0000

[Manual Baseline Hours / Week] = 
6.0

[Automated Pipeline Hours / Week] = 
0.167

[Annual Analyst Hours Saved] = 
303.3

[Annual Recoverable Value ($)] = 
1688452.14
