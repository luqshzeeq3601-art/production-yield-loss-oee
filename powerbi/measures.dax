// =============================================================================
// PRODUCTION YIELD LOSS & OEE EARLY-WARNING SYSTEM — DAX MEASURE LIBRARY
// =============================================================================
// All measures derive from underlying additive fact components.
// Never use AVERAGE() over pre-calculated row ratios for OEE, A, P, or Q.
// =============================================================================

// -----------------------------------------------------------------------------
// 1. CORE TIME & PRODUCTION VOLUME MEASURES
// -----------------------------------------------------------------------------

[Planned Production Time (h)] = 
SUM(fact_production_hourly[planned_time_min]) / 60.0

[Run Time (h)] = 
SUM(fact_production_hourly[run_time_min]) / 60.0

[Ideal Operating Basis (h)] = 
SUMX(
    fact_production_hourly,
    fact_production_hourly[ideal_cycle_time_s] * fact_production_hourly[total_count]
) / 3600.0

[Total Units] = 
SUM(fact_production_hourly[total_count])

[Good Units] = 
SUM(fact_production_hourly[good_count])

[Scrap Units] = 
SUM(fact_production_hourly[scrap_count])

[Yield %] = 
DIVIDE([Good Units], [Total Units], BLANK())

[Scrap Rate %] = 
DIVIDE([Scrap Units], [Total Units], BLANK())


// -----------------------------------------------------------------------------
// 2. OEE CORE MEASURES (AVAILABILITY x PERFORMANCE x QUALITY)
// -----------------------------------------------------------------------------

[Availability] = 
DIVIDE([Run Time (h)], [Planned Production Time (h)], BLANK())

[Performance] = 
DIVIDE([Ideal Operating Basis (h)], [Run Time (h)], BLANK())

[Quality] = 
DIVIDE([Good Units], [Total Units], BLANK())

[OEE] = 
[Availability] * [Performance] * [Quality]

[OEE Target] = 
0.85

[OEE vs Target] = 
[OEE] - [OEE Target]

[OEE Target Status] = 
IF([OEE] >= [OEE Target], "On Target", "Below Target")


// -----------------------------------------------------------------------------
// 3. LOSS & COST DECOMPOSITION MEASURES
// -----------------------------------------------------------------------------

[Downtime Minutes] = 
SUM(fact_downtime_event[duration_min])

[Downtime Hours] = 
[Downtime Minutes] / 60.0

[Downtime Events] =
COUNTROWS(fact_downtime_event)

[Unplanned Downtime Hours] = 
CALCULATE(
    [Downtime Hours],
    dim_downtime_reason[is_planned] = FALSE()
)

[Planned Downtime Hours] = 
CALCULATE(
    [Downtime Hours],
    dim_downtime_reason[is_planned] = TRUE()
)

[Availability Loss Hours] = 
[Planned Production Time (h)] - [Run Time (h)]

[Performance Loss Hours] = 
[Run Time (h)] - [Ideal Operating Basis (h)]

[Quality Equivalent Loss Hours] = 
SUMX(
    fact_production_hourly,
    fact_production_hourly[ideal_cycle_time_s] * fact_production_hourly[scrap_count]
) / 3600.0

[Total Scrap Cost] = 
SUM(fact_quality_scrap[scrap_cost])

[Top 3 Scrap Cost] = 
CALCULATE(
    [Total Scrap Cost],
    dim_defect_cause[cause_code] IN {"dimensional", "surface defect", "contamination"}
)

[Top 3 Scrap Cost Share] = 
DIVIDE([Top 3 Scrap Cost], [Total Scrap Cost], BLANK())


// -----------------------------------------------------------------------------
// 4. PARETO DAX MEASURES
// -----------------------------------------------------------------------------

[Scrap Cost All Causes] = 
CALCULATE(
    [Total Scrap Cost],
    ALLSELECTED(dim_defect_cause)
)

[Cum Scrap Cost] = 
VAR CurrentCost = [Total Scrap Cost]
RETURN
SUMX(
    FILTER(
        ALLSELECTED(dim_defect_cause),
        [Total Scrap Cost] >= CurrentCost
    ),
    [Total Scrap Cost]
)

[Cum % Scrap Cost] = 
DIVIDE([Cum Scrap Cost], [Scrap Cost All Causes], BLANK())

[Downtime All Reasons] = 
CALCULATE(
    [Downtime Hours],
    ALLSELECTED(dim_downtime_reason)
)

[Cum Downtime Hours] = 
VAR CurrentDT = [Downtime Hours]
RETURN
SUMX(
    FILTER(
        ALLSELECTED(dim_downtime_reason),
        [Downtime Hours] >= CurrentDT
    ),
    [Downtime Hours]
)

[Cum % Downtime] = 
DIVIDE([Cum Downtime Hours], [Downtime All Reasons], BLANK())


// -----------------------------------------------------------------------------
// 5. CAPACITY, MANPOWER & BOTTLENECK OPERATIONS
// -----------------------------------------------------------------------------

[Planned Headcount] = 
SUM(fact_manpower_shift[planned_headcount])

[Actual Headcount] = 
SUM(fact_manpower_shift[actual_headcount])

[Manpower Gap] = 
[Planned Headcount] - [Actual Headcount]

[Capacity Utilization %] = 
DIVIDE([Run Time (h)], [Planned Production Time (h)], BLANK())

[Average Processing Time (s)] = 
AVERAGE(fact_station_operation[processing_time_s])

[Average Wait Time (s)] = 
AVERAGE(fact_station_operation[wait_time_s])

[Bottleneck Processing Time (s)] = 
CALCULATE(
    [Average Processing Time (s)],
    dim_station_machine[is_bottleneck] = TRUE()
)


// -----------------------------------------------------------------------------
// 6. SPC, EARLY WARNING & DATA QUALITY MEASURES
// -----------------------------------------------------------------------------

[Alerts Total] = 
COUNTROWS(fact_spc_alert)

[Alerts Open] = 
CALCULATE(
    COUNTROWS(fact_spc_alert),
    fact_spc_alert[status] = "open"
)

[Alerts Critical] = 
CALCULATE(
    COUNTROWS(fact_spc_alert),
    fact_spc_alert[severity] = "critical"
)

[Median Detection Latency (h)] = 
CALCULATE(MAX(pb_spc_methods[median_detection_latency_hours]), pb_spc_methods[method] = "WE+EWMA+T2")

[Median Early Detection Advantage (h)] =
CALCULATE(MAX(pb_spc_methods[median_hours_saved]), pb_spc_methods[method] = "WE+EWMA+T2")

[WE Precision %] =
CALCULATE(MAX(pb_spc_methods[precision]), pb_spc_methods[method] = "WE")

[WE EWMA Precision %] =
CALCULATE(MAX(pb_spc_methods[precision]), pb_spc_methods[method] = "WE+EWMA")

[Combined Precision %] =
CALCULATE(MAX(pb_spc_methods[precision]), pb_spc_methods[method] = "WE+EWMA+T2")

[Alert Precision %] = 
[Combined Precision %]

[Alert Recall %] = 
CALCULATE(MAX(pb_spc_methods[recall]), pb_spc_methods[method] = "WE+EWMA+T2")

[Excursions Caught Before Manual Report %] = 
CALCULATE(MAX(pb_spc_methods[pct_failures_before_manual]), pb_spc_methods[method] = "WE+EWMA+T2") / 100.0

[Phase II Lots] =
COUNTROWS(pb_spc_lots)

[Phase II Failures] =
CALCULATE(COUNTROWS(pb_spc_lots), pb_spc_lots[target] = 1)

[Phase II Failure Prevalence %] =
DIVIDE([Phase II Failures], [Phase II Lots], BLANK())

[Combined False Alerts / 100 Lots] =
CALCULATE(MAX(pb_spc_methods[false_alarms_per_100_lots]), pb_spc_methods[method] = "WE+EWMA+T2")

[Failures Detected] =
IF(HASONEVALUE(pb_spc_methods[method]), MAX(pb_spc_methods[TP]), BLANK())

[Failure Lead-Time Count] =
COUNTROWS(pb_spc_failures)

[SPC Reading Value] =
SELECTEDVALUE(fact_sensor_reading[reading_value])

[SPC Centerline] =
MAX(fact_sensor_reading[centerline])

[SPC UCL] =
MAX(fact_sensor_reading[ucl])

[SPC LCL] =
MIN(fact_sensor_reading[lcl])

[SPC Violation Value] =
CALCULATE([SPC Reading Value], fact_sensor_reading[we_violation] = TRUE())

[Manual Baseline Hours / Week] = 
CALCULATE(MAX(pb_impact_metrics[numeric_value]), pb_impact_metrics[metric_id] = "RA-001")

[Automated Pipeline Hours / Week] = 
CALCULATE(MAX(pb_impact_metrics[numeric_value]), pb_impact_metrics[metric_id] = "RA-003") / 60.0

[Annual Analyst Hours Saved] = 
CALCULATE(MAX(pb_impact_metrics[numeric_value]), pb_impact_metrics[metric_id] = "RA-006")

[Annual Recoverable Value ($)] = 
CALCULATE(MAX(pb_impact_metrics[numeric_value]), pb_impact_metrics[metric_id] = "WIF-006")

// -----------------------------------------------------------------------------
// 7. WORK ORDERS: OBSERVED SOURCE STATUS AND SIMULATOR ON-TIME FLAG
// -----------------------------------------------------------------------------

[Work Orders Total] =
COUNTROWS(vw_work_orders)

[Completed Work Orders] =
CALCULATE([Work Orders Total], vw_work_orders[status] = "complete")

[Partial Work Orders] =
CALCULATE([Work Orders Total], vw_work_orders[status] = "partial")

[WO Completion %] =
DIVIDE([Completed Work Orders], [Work Orders Total], BLANK())

[WO On-Time %] =
DIVIDE(CALCULATE([Work Orders Total], vw_work_orders[on_time] = 1), [Work Orders Total], BLANK())

[WO Planned Units] =
SUM(vw_work_orders[planned_qty])

[WO Produced Units] =
SUM(vw_work_orders[produced_qty])

[WO Good Units] =
SUM(vw_work_orders[good_qty])

[WO Scrap Units] =
SUM(vw_work_orders[scrap_qty])

[Throughput Units / Run Hour] =
DIVIDE([Total Units], [Run Time (h)], BLANK())

// -----------------------------------------------------------------------------
// 8. LIVE DQ SNAPSHOT AND ARTIFACT RECONCILIATION
// -----------------------------------------------------------------------------

[DQ Checks Total] =
COUNTROWS(pb_dq_checks)

[DQ Checks Passed] =
CALCULATE(COUNTROWS(pb_dq_checks), pb_dq_checks[status] = "PASS")

[DQ Violations] =
SUM(pb_dq_checks[violation_count])

[DQ Pass %] =
DIVIDE([DQ Checks Passed], [DQ Checks Total], BLANK())

[DQ Status] =
IF([DQ Pass %] = 1.0, "PASS", "FAIL")

[Reconciliation Pass %] =
DIVIDE(CALCULATE(COUNTROWS(pb_reconciliation), pb_reconciliation[status] = "PASS"), COUNTROWS(pb_reconciliation), BLANK())

// Physical time bridge; the final basis is product-weighted ideal good time.
[Ideal Good Output Basis (h)] =
SUMX(fact_production_hourly, fact_production_hourly[ideal_cycle_time_s] * fact_production_hourly[good_count]) / 3600.0

[OEE Bridge Hours] =
SWITCH(SELECTEDVALUE(pb_oee_bridge[step]),
    "Planned", [Planned Production Time (h)],
    "Availability Loss", -[Availability Loss Hours],
    "Performance Loss", -[Performance Loss Hours],
    "Quality Loss", -[Quality Equivalent Loss Hours],
    "Good Output", [Ideal Good Output Basis (h)], BLANK())
