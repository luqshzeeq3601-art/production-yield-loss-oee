# Raw and interim data stay local.
data/raw/
data/interim/

# Large generated artifacts stay local (reproducible via src/ingest_metropt3.py).
data/processed/metropt3_readings.csv

# Environment files and common secret material.
.env
.env.*
!.env.example
*.key
*.pem
*.p12
*.pfx
*.secret
*.secrets
secrets/

# Temporary Power BI backup files.
~$*.pbix
*.pbix~
*.pbix.bak
*.pbix.backup
*.pbix.tmp
*.pbit.bak
*.pbit.backup
*.pbit.tmp

# Python build artifacts.
build/
dist/
*.egg-info/

# Python bytecode and caches.
__pycache__/
*.py[cod]

# Test and coverage artifacts.
.pytest_cache/
.coverage
.coverage.*
htmlcov/

# Local Python environment.
.venv/
