# Copy to `.env` and fill in local values. Never commit `.env`.
# Only placeholders below — no real credentials.

# PostgreSQL connection used by src/load_db.py (via POSTGRES_USER / POSTGRES_PASSWORD).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGEME

# Optional full database URL override. When set, src/load_db.py uses it directly.
# DATABASE_URL=postgresql://postgres:CHANGEME@localhost:5432/production_yield_oee
