# Copy to `.env` and fill in local values. Never commit `.env`.
# Only placeholders below — no real credentials.

# Explicitly loaded by scripts.bootstrap_powerbi_db; process environment wins.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=production_yield_oee
POSTGRES_USER=powerbi_local
POSTGRES_PASSWORD=CHANGEME

# Optional full database URL override. When set, src/load_db.py uses it directly.
# DATABASE_URL=postgresql://powerbi_local:CHANGEME@127.0.0.1:5432/production_yield_oee
